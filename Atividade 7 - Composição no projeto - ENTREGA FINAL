- classe todo 
public class Todo {

    private Parte parte;

    public Todo() {
        // A Parte é criada internamente pelo Todo
        this.parte = new Parte();
    }

    public void removerParte() {
        this.parte = null;
    }

    public double calcular() {
        return parte.calcular();
    }

    public Parte getParte() {
        return parte;
    }
}

