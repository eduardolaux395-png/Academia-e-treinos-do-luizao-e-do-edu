import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.Test;

public class TodoTest {

    @Test
    public void deveDelegarCalculoParaParte() {
        Todo todo = new Todo();

        double resultado = todo.calcular();

        assertEquals(100.0, resultado);
    }

    @Test
    public void deveRemoverParte() {
        Todo todo = new Todo();

        assertNotNull(todo.getParte());

        todo.removerParte();

        assertNull(todo.getParte());
    }
}

